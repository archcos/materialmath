// Cloudflare config: serves the built dist/ folder as a static site.
// Deploys happen only through GitHub: Cloudflare runs `npm test && npm run build` then `npx wrangler deploy` on every push to main.
{
  "name": "materialmath",
  "compatibility_date": "2026-11-01",
  // Keeps the backup address materialmath.arjay-charcos25.workers.dev working. Pages point Google at materialmath.org
  // (canonical tags), so leaving it on is harmless; set false once the domain is confirmed working if you prefer.
  "workers_dev": true,
  // Cloudflare creates the DNS records for these on deploy; the zone must be Active in this account first.
  // www is redirected to the bare domain by a Redirect Rule in the dashboard (Rules > Redirect Rules).
  "routes": [
    { "pattern": "materialmath.org", "custom_domain": true },
    { "pattern": "www.materialmath.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
